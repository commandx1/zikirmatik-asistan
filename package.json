{
  "name": "zikirmatik-asistan",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "detox"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter api test:e2e",
    "db:test": "docker compose up -d --wait mongo-test",
    "db:test:down": "docker compose down -v",
    "typecheck": "turbo run typecheck",
    "test:web": "pnpm --filter @zikirmatik/website test:web",
    "test:detox": "pnpm --filter @zikirmatik/mobile test:detox:ios",
    "seed:e2e": "pnpm --filter api seed:e2e",
    "test:load": "pnpm --filter api test:load:smoke",
    "parity:check": "node scripts/visual-regression/compare.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.0.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "turbo": "^2.0.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.4"
  }
}
