# apps/api ortam değişkenleri şablonu. Gerçek değerleri buraya YAZMAYIN —
# bu dosya git'e commitlenir; sırlar yalnızca .env (gitignore'da) içinde durur.
# Kopyala: cp apps/api/.env.example apps/api/.env

# ── Veritabanı ────────────────────────────────────────────────────────────
MONGODB_URI=

# ── OpenAI (öneri/sohbet/embedding) ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2

# ── AI Rehber / AI Sohbet pipeline ayarları (bkz. ai-runtime.service.ts) ──
AI_SELECT_MODEL=gpt-5
AI_CHAT_MODEL=gpt-5
AI_CLASSIFY_MODEL=gpt-5-mini
AI_EXPAND_MODEL=gpt-5-mini
AI_SELECT_REASONING_EFFORT=minimal
AI_CHAT_REASONING_EFFORT=low
AI_SELECT_TIMEOUT_MS=30000
AI_CHAT_TIMEOUT_MS=45000
AI_CLASSIFY_TIMEOUT_MS=8000
AI_EXPAND_TIMEOUT_MS=8000
AI_PASSAGE_MIN_SCORE=0.68
AI_HYBRID_SEARCH=1
# Zikir $text bacağı eval-driven olarak varsayılan kapalı — kaynak pasajı
# hibrit araması AI_HYBRID_SEARCH=1 ile açık kalmaya devam eder.
AI_DHIKR_HYBRID_SEARCH=0
AI_TEXT_MIN_REL_SCORE=0.35
AI_CANDIDATE_LIMIT=15
AI_RAG_PASSAGE_LIMIT=4
AI_CHAT_PASSAGE_LIMIT=6
AI_MODEL_PRICES_JSON=
AI_CREDIT_TOPUP_PRODUCTS=topupsmall:10,topupmedium:30,topuplarge:75

# ── AI Vird Programı (bkz. vird-program-agent.service.ts, docs/vird-programi.md) ──
AI_PROGRAM_MODEL=gpt-5
AI_PROGRAM_REASONING_EFFORT=low
AI_PROGRAM_TIMEOUT_MS=45000
# Bir fazın bir diliminde (morning/prayer/evening/night/free) en fazla bu
# kadar zikir olabilir — buildProgram doğrulama kapısı.
AI_VIRD_MAX_ITEMS_PER_SLOT=4

# ── Gemini (opsiyonel ikincil sağlayıcı) ──────────────────────────────────
GEMINI_API_KEY=

# ── RevenueCat / satın alma webhook'u ─────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ALLOW_SANDBOX_EVENTS=
# RevenueCat REST secret key (sk_...). İstemcinin POST /v1/subscriptions ve
# sync-user çağrıları bununla sunucu tarafında doğrulanır. Render'da
# tanımlanmalı; yoksa prod'da istemci abonelik yazımı kapalı (503), premium
# yalnız webhook + 30 dk cron ile gelir. Dev/test'te yoksa istemciye güvenilir.
# (Boş bırakılamaz: tanımlıysa dolu olmalı — kullanmıyorsan satırı yorumda tut.)
# REVENUECAT_SECRET_API_KEY=
# Doğrulanan entitlement kimliği (mobil EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID ile aynı).
REVENUECAT_PREMIUM_ENTITLEMENT_ID=premium

# ── Katalog yazma (POST/PATCH/DELETE /v1/dhikrs, /v1/special-days) ──────────
# İstekte `x-admin-secret: <değer>` header'ı gerekir. Boşsa bu rotalar HER
# ortamda 401 döner (fail-closed, dev bypass yok).
# (Tanımlıysa boş olamaz.)
# ADMIN_API_SECRET=

# ── Push kampanyaları (GitHub Actions cron -> POST /internal/campaigns/:campaign) ──
# bkz. apps/api/docs/notification-campaigns-runbook.md
CAMPAIGN_TRIGGER_SECRET=
# GET /app-config ile mobile bildirilir; '1' olduğunda mobil cihazlar yerel
# kandil/özel gün bildirimini zamanlamayı sunucu push'una bırakır (bkz.
# use-event-notification-sync.ts). Yalnızca Render'da CAMPAIGN_TRIGGER_SECRET
# tanımlı VE GitHub Actions workflow'u (campaign-triggers.yml) gerçek gönderim
# yaptığı doğrulandıktan SONRA '1' yap — bkz. runbook "Devreye alma sırası".
SERVER_PUSH_ENABLED=0

# ── Mobil auth / audience doğrulama ───────────────────────────────────────
APPLE_AUDIENCES=
GOOGLE_CLIENT_IDS=
EXPO_PUBLIC_API_BASE_URL=

# ── Auth token'ları ────────────────────────────────────────────────────────
AUTH_ALLOW_INSECURE_TEST_TOKENS=
AUTH_REFRESH_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL_MINUTES=

# ── Gözlemlenebilirlik (bkz. apps/api/src/common/logging/) ───────────────
# Tümü opsiyonel, tanımsız bırakılabilir.
# error | warn | info | debug | verbose. Varsayılan: prod'da info, dev'de debug.
LOG_LEVEL=
# Tanımlıysa loglar stdout'un yanında toplu HTTPS POST ile buraya da gider
# (örn. Better Stack). Tanımlıysa LOG_DRAIN_TOKEN zorunludur.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
# Tanımlıysa kritik hatalar (5xx, unhandledRejection, mongo.down, vb.) bu
# Slack Incoming Webhook'a gider; tanımsızsa alarm tamamen kapalı.
SLACK_ALERT_WEBHOOK_URL=
# Gürültüsüz rotalarda (bkz. QUIET) erişim satırı yalnız bu eşiği (ms)
# aşarsa loglanır. Varsayılan: 1000.
ACCESS_LOG_SLOW_MS=

# ── Diğer ──────────────────────────────────────────────────────────────────
APP_MIN_VERSION=0
NODE_ENV=development
PORT=3000
