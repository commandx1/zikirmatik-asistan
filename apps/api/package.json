{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --maxWorkers=2",
    "seed:dhikrs": "node scripts/seed-dhikrs.mjs",
    "seed:collections": "node scripts/seed-collections.mjs",
    "seed:vird-templates": "node scripts/seed-vird-templates.mjs",
    "seed:e2e": "node scripts/e2e-seed.mjs",
    "seed:embeddings": "node scripts/backfill-dhikr-embeddings.mjs",
    "seed:special-days": "node scripts/seed-special-days.mjs",
    "seed:special-days:kurban-2026": "node scripts/seed-special-days.mjs --event kurban-bayrami-2026",
    "seed:special-days:zilhicce-2026": "node scripts/seed-special-days.mjs --event zilhicce-ilk-on-2026",
    "seed:special-days:mevlid-2026": "node scripts/seed-special-days.mjs --event mevlid-kandili-2026",
    "seed:special-days:muharrem-2026": "node scripts/seed-special-days.mjs --event muharrem-ilk-on-2026",
    "gen:special-days-mobile": "node scripts/gen-special-days-mobile.mjs",
    "eval:rehber": "ts-node -r tsconfig-paths/register scripts/eval/run-rehber-eval.ts",
    "eval:chat": "ts-node -r tsconfig-paths/register scripts/eval/run-chat-eval.ts",
    "eval:retrieval": "ts-node -r tsconfig-paths/register scripts/eval/run-retrieval-eval.ts",
    "eval:vird": "ts-node -r tsconfig-paths/register scripts/eval/run-vird-eval.ts",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:load:smoke": "k6 run -e PROFILE=smoke -e SCENARIO=all load/run.js",
    "test:load:load": "k6 run -e PROFILE=load -e SCENARIO=all load/run.js",
    "test:load:spike": "k6 run -e PROFILE=spike -e SCENARIO=all load/run.js",
    "test:load:circle": "node load/seed.mjs && k6 run -e PROFILE=smoke -e SCENARIO=circle load/run.js && node load/verify-circle.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.74",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/websockets": "^11.1.27",
    "ai": "^6.0.208",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "^4.4.0",
    "expo-server-sdk": "^3.15.0",
    "mongoose": "^9.6.1",
    "openai": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!main.ts",
      "!app.setup.ts",
      "!**/*.module.ts",
      "!**/schemas/**",
      "!**/dto/**",
      "!**/testing/**",
      "!**/eval/**",
      "!**/*.types.ts",
      "!**/*.constants.ts",
      "!**/*.d.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 71,
        "branches": 57
      }
    }
  }
}
