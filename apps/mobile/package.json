{
  "name": "@zikirmatik/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "build": "expo export",
    "lint": "eslint app src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:detox:build:ios": "detox build -c ios.sim.release",
    "test:detox:ios": "detox test -c ios.sim.release",
    "test:detox:build:android": "detox build -c android.emu.release",
    "test:detox:android": "detox test -c android.emu.release",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "install-skia"
  },
  "dependencies": {
    "@callstack/liquid-glass": "^0.8.2",
    "@expo-google-fonts/finlandica": "^0.4.0",
    "@expo-google-fonts/indie-flower": "^0.2.3",
    "@expo-google-fonts/intel-one-mono": "^0.4.0",
    "@expo-google-fonts/merriweather": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "7.15.10",
    "@shopify/react-native-skia": "^2.6.4",
    "@tanstack/react-query": "^5.75.7",
    "@zikirmatik/shared": "workspace:*",
    "@zikirmatik/ui": "workspace:*",
    "adhan": "^4.4.6",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.7",
    "expo-application": "~7.0.8",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.11",
    "expo-router": "~6.0.24",
    "i18next": "^26.3.6",
    "nativewind": "4.2.3",
    "react": "19.1.0",
    "react-i18next": "^17.0.9",
    "react-native": "0.81.5",
    "react-native-android-widget": "0.22.1",
    "react-native-css-interop": "0.2.3",
    "react-native-pager-view": "^6.9.1",
    "react-native-purchases": "^9.3.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.4",
    "detox": "^20.51.4",
    "jest": "^30.4.1",
    "tailwindcss": "3.4.17"
  }
