{
  "cli": {
    "version": ">= 18.0.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "1"
      }
    },
    "internalTest": {
      "env": {
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ADMOB_USE_TEST_ADS": "1"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
