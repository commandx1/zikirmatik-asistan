{
  "expo": {
    "name": "Zikirmatik Rehber",
    "slug": "zikirmatik-rehber",
    "scheme": [
      "zikirmatik",
      "zikirmatikasistan"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zikirmatik_asistan.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1423"
      },
      "package": "com.zikirmatik_asistan.app"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92c9a554-6e71-4839-a779-35da89710140"
      }
    }
  }
}
